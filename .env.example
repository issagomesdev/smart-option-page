# =============================================================================
# Smart Option — Landing Page — variáveis de ambiente
#
# Este arquivo lista todas as variáveis usadas pelo projeto, com valores de
# referência. Copie para ".env" tanto em desenvolvimento quanto em produção:
#   cp .env.example .env
#
# Onde o valor precisa mudar de um ambiente para o outro, isso é explicado no
# comentário logo acima da variável.
# =============================================================================

# --- Porta ---------------------------------------------------------------
# Porta em que o Vite (dev server ou preview) escuta. Lida só no
# vite.config.ts (Node/build-time) — nunca hardcoded em código.
# Em desenvolvimento: 3002 por padrão, para não colidir com o backend (3000)
# nem com o painel administrativo (3001) quando os três rodam juntos.
# Em produção: é a porta publicada pelo docker-compose.prod.yml, mapeada para
# a porta 80 do container Nginx — ajuste conforme a porta disponível na sua
# infraestrutura.
APP_PORT=3000

# --- Links públicos --------------------------------------------------------
# Prefixo VITE_ obrigatório para qualquer variável lida pelo código do
# navegador (convenção do Vite).
VITE_GITHUB_URL=https://github.com/issagomesdev/smart-option
# Botões "Demo do Bot" e "Demo do Painel" do Header.
VITE_BOT_DEMO_URL=https://t.me/smartoptiondemo_bot
VITE_ADMIN_DEMO_URL=https://so-panel-demo.byissa.dev

# Links da seção "Por Trás do Projeto".
VITE_LINKEDIN_URL=https://linkedin.com/in/issagomesdev
VITE_PORTFOLIO_URL=https://byissa.dev
VITE_DEVELOPER_EMAIL=contato@byissa.dev
# Foto da desenvolvedora em "Por Trás do Projeto". Deixe em branco para manter
# o placeholder ("Foto em breve") — quando preenchida, a foto real é exibida.
VITE_DEVELOPER_PHOTO_URL=https://media.byissa.dev/profile/profile.webp

# API que alimenta o modal de seleção de currículos (botão "Currículo" do
# Contato e de "Por Trás do Projeto") — retorna um array de currículos.
VITE_CURRICULUM_API_URL=https://api.byissa.dev/curriculums
