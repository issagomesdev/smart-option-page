# Multi-stage build: compile the static bundle, then serve it from a minimal Nginx image —
# the final image ships no Node.js, no source, no dev dependencies.

FROM node:22-alpine AS builder
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

# Vite inlines VITE_-prefixed variables into the bundle at build time, so each one has to be
# supplied as a build arg here — docker-compose.prod.yml forwards them from the deploy-time .env.
ARG VITE_GITHUB_URL
ARG VITE_BOT_DEMO_URL
ARG VITE_ADMIN_DEMO_URL
ARG VITE_LINKEDIN_URL
ARG VITE_PORTFOLIO_URL
ARG VITE_DEVELOPER_EMAIL
ARG VITE_DEVELOPER_PHOTO_URL
ARG VITE_CURRICULUM_API_URL
ENV VITE_GITHUB_URL=${VITE_GITHUB_URL}
ENV VITE_BOT_DEMO_URL=${VITE_BOT_DEMO_URL}
ENV VITE_ADMIN_DEMO_URL=${VITE_ADMIN_DEMO_URL}
ENV VITE_LINKEDIN_URL=${VITE_LINKEDIN_URL}
ENV VITE_PORTFOLIO_URL=${VITE_PORTFOLIO_URL}
ENV VITE_DEVELOPER_EMAIL=${VITE_DEVELOPER_EMAIL}
ENV VITE_DEVELOPER_PHOTO_URL=${VITE_DEVELOPER_PHOTO_URL}
ENV VITE_CURRICULUM_API_URL=${VITE_CURRICULUM_API_URL}
RUN npm run build

FROM nginx:1.27-alpine AS runtime
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/dist /usr/share/nginx/html

HEALTHCHECK --interval=30s --timeout=5s --retries=3 CMD wget -qO- http://127.0.0.1/health || exit 1

# Nginx listens on 80 inside the container regardless of environment — the port visitors actually
# use is whatever APP_PORT maps to it in docker-compose.prod.yml.
EXPOSE 80
